# JPYC CLI local environment example
# Copy to .env.local and fill real values. Never commit .env.local.

# Alchemy API key used by npm run test:fork:alchemy.
# This derives:
# - JPYC_ETHEREUM_FORK_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
# - JPYC_POLYGON_FORK_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<key>
# - JPYC_AVALANCHE_FORK_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/<key>
JPYC_ALCHEMY_API_KEY=replace-me

# Optional: override any chain RPC URL directly.
# JPYC_ETHEREUM_FORK_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/replace-me
# JPYC_POLYGON_FORK_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/replace-me
# JPYC_AVALANCHE_FORK_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/replace-me
